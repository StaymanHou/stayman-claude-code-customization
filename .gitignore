tests/results/*.json
.DS_Store

# Playwright MCP working dir (per-run snapshots/logs/screenshots from agent test runs)
.playwright-mcp/

# Agent verify-self screenshot artifacts (kept in WIP/backlog if useful; not in the repo)
viz-phase*.png
viz-*-fullpage.png
wp5b-*.png
tools/claude-time/viz/verify-self-screenshot*.png

# Local-only verify-self emitted HTML (consumable; re-emit on demand)
tmp/

# Python bytecode caches (generated by py_compile / unittest runs)
__pycache__/
*.pyc

# Per-machine Claude Code state (not shared between developers)
.claude/settings.local.json

# Transient session pointer (recreated by /session-pause, deleted on /session-resume)
workflow/.session.md

# NOTE — artifact tracking overrides (see CLAUDE.md → "## Artifact tracking overrides"):
# This repo IS the learning-assets/source repo, so .claude/learnings/ AND .claude/memory/
# are TRACKED (not ignored) — they are curated content here, not drafts. Do NOT add ignore
# patterns for them. Any individual memory carrying secrets/PII is redacted in place or added
# to this .gitignore file-by-file (expected rare), per the policy's PII clause.
