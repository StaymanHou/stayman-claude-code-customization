#!/usr/bin/env python3
"""claude-time CLI — query the local claude-time SQLite database.

Usage:
  claude-time report                        # today
  claude-time report --weekly               # last 7 days
  claude-time report --date 2026-05-15      # specific day
  claude-time report --session <uuid>       # filter by session_id
  claude-time report --cwd /Users/me/proj   # filter by working dir
  claude-time report --by cwd               # group by working directory
  claude-time report --by session           # group by session_id
  claude-time report --by day               # group by calendar date
  claude-time report --db /tmp/test.sqlite  # override DB path

All filters can be combined. Output is a plain text table.
"""

from __future__ import annotations

import argparse
import json
import os
import sqlite3
import subprocess
import sys
from datetime import date, datetime, time, timedelta
from pathlib import Path

# Make sibling reclassify module importable.
_HERE = Path(__file__).resolve().parent
sys.path.insert(0, str(_HERE))
import reclassify  # noqa: E402


# ── Defaults ────────────────────────────────────────────────────────────────
DEFAULT_CONFIG = {
    "chars_per_sec": 6.0,
    "reading_threshold_sec": 120,
    "thinking_threshold_sec": 300,
    "project_names": {},
    # WP5b: multi-day data window for `visualize` Day view. Defaults pad the
    # window by ±21 days (14 prior + 7 after) around the target day so panning
    # past the day boundary reveals real events. Per-invocation override via
    # --context-days-prior / --context-days-after CLI flags.
    "viz_context_days_prior": 14,
    "viz_context_days_after": 7,
    # WP8: cap for `visualize --range START:END` window length. Beyond this,
    # tick density + DOM segment count make the timeline unwieldy. Overridable
    # via `viz_custom_range_max_days` in ~/.claude-time/config.json.
    "viz_custom_range_max_days": 90,
}


def _validate_nonneg_int(raw) -> int | None:
    """Accept a non-negative int. Return None to signal "use default" on bad input."""
    if isinstance(raw, bool):  # bool is an int subclass — exclude it explicitly
        return None
    if isinstance(raw, int) and raw >= 0:
        return raw
    return None


def _validate_project_names(raw) -> dict[str, list[str]]:
    """Accept only {name: [path, ...]} with string keys and list-of-strings values.
    Silent drop on any malformed entry."""
    if not isinstance(raw, dict):
        return {}
    cleaned: dict[str, list[str]] = {}
    for name, paths in raw.items():
        if not isinstance(name, str) or not isinstance(paths, list):
            continue
        if not all(isinstance(p, str) for p in paths):
            continue
        cleaned[name] = list(paths)
    return cleaned


def load_config(claude_time_dir: Path) -> dict:
    """Load ~/.claude-time/config.json on top of defaults. Silent fallback."""
    cfg_path = claude_time_dir / "config.json"
    cfg = dict(DEFAULT_CONFIG)
    if cfg_path.exists():
        try:
            user_cfg = json.loads(cfg_path.read_text())
            if isinstance(user_cfg, dict):
                for k, v in user_cfg.items():
                    if k == "project_names":
                        cfg[k] = _validate_project_names(v)
                    elif k in ("viz_context_days_prior", "viz_context_days_after",
                               "viz_custom_range_max_days"):
                        validated = _validate_nonneg_int(v)
                        if validated is not None:
                            cfg[k] = validated
                    elif k in cfg:
                        cfg[k] = v
        except (json.JSONDecodeError, OSError):
            pass  # silent fallback to defaults
    return cfg


# ── Date-window logic ───────────────────────────────────────────────────────
def window_ms(
    *, weekly: bool, date_str: str | None
) -> tuple[int, int, str]:
    """Compute the (start_ms, end_ms_exclusive, label) for the report window.

    Boundaries are local-timezone midnight. The end boundary is exclusive
    so a single-day window contains exactly that day's events.
    """
    today = date.today()
    if date_str:
        start_day = date.fromisoformat(date_str)
        end_day_excl = start_day + timedelta(days=1)
        label = f"date {start_day.isoformat()}"
    elif weekly:
        end_day_excl = today + timedelta(days=1)
        start_day = today - timedelta(days=6)
        label = f"week ending {today.isoformat()}"
    else:
        start_day = today
        end_day_excl = today + timedelta(days=1)
        label = f"today ({today.isoformat()})"
    start_dt = datetime.combine(start_day, time.min)
    end_dt = datetime.combine(end_day_excl, time.min)
    return (
        int(start_dt.timestamp() * 1000),
        int(end_dt.timestamp() * 1000),
        label,
    )


# ── DB read ─────────────────────────────────────────────────────────────────
def load_events(
    db_path: Path,
    *,
    start_ms: int,
    end_ms: int,
    session_filter: str | None,
    cwd_filter: str | None,
) -> list[dict]:
    """Read events from the DB within the window, optionally filtered."""
    if not db_path.exists():
        return []
    conn = sqlite3.connect(f"file:{db_path}?mode=ro", uri=True)
    conn.row_factory = sqlite3.Row
    try:
        sql = "SELECT * FROM events WHERE ts >= ? AND ts < ?"
        params: list = [start_ms, end_ms]
        if session_filter:
            sql += " AND session_id = ?"
            params.append(session_filter)
        if cwd_filter:
            sql += " AND cwd = ?"
            params.append(cwd_filter)
        sql += " ORDER BY ts"
        rows = [dict(r) for r in conn.execute(sql, params)]
    finally:
        conn.close()
    return rows


# ── Output formatting ──────────────────────────────────────────────────────
def fmt_ms(ms: int) -> str:
    """Human-readable duration. 1500 → '1.5s'; 90000 → '1m30s'; 3700000 → '1h1m'."""
    if ms < 1000:
        return f"{ms}ms"
    seconds = ms / 1000
    if seconds < 60:
        return f"{seconds:.1f}s"
    minutes, sec = divmod(int(seconds), 60)
    if minutes < 60:
        return f"{minutes}m{sec}s" if sec else f"{minutes}m"
    hours, minutes = divmod(minutes, 60)
    return f"{hours}h{minutes}m" if minutes else f"{hours}h"


GROUP_DIMS = ("cwd", "session", "day")
MISC_LABEL = "misc"


def _auto_alias_for_cwd(cwd: str, _cache: dict[str, str] = {}) -> str:
    """Auto-derive a friendly label for a cwd when no explicit alias is set.

    Resolution:
      - cwd is inside a git repo → basename(repo_root)
      - cwd is not in a git repo, or the cwd no longer exists → MISC_LABEL

    Results are memoized in `_cache` to avoid re-running git for repeated cwds
    in the same report. The mutable-default-arg pattern is intentional here as
    a process-scoped LRU; module is also short-lived (one `claude-time` run).
    """
    if cwd in _cache:
        return _cache[cwd]
    label = MISC_LABEL
    try:
        if cwd and Path(cwd).exists():
            result = subprocess.run(
                ["git", "-C", cwd, "rev-parse", "--show-toplevel"],
                capture_output=True,
                text=True,
                timeout=2,
            )
            if result.returncode == 0:
                repo_root = result.stdout.strip()
                if repo_root:
                    label = Path(repo_root).name or MISC_LABEL
    except (subprocess.SubprocessError, OSError):
        pass  # silent fallback to MISC_LABEL
    _cache[cwd] = label
    return label


def _group_key(ev: dict, dim: str) -> str:
    """Return the grouping key for an event under the chosen dimension."""
    if dim == "cwd":
        return ev.get("cwd") or "<unknown>"
    if dim == "session":
        return ev.get("session_id") or "<unknown>"
    if dim == "day":
        ts = ev.get("ts", 0)
        return datetime.fromtimestamp(ts / 1000).date().isoformat()
    raise ValueError(f"unknown group dimension: {dim}")


def _short_label(label: str, dim: str, width: int) -> str:
    """Truncate session IDs (long UUIDs) for the grouped table; pass others through."""
    if dim == "session" and len(label) > width:
        return label[: width - 1] + "…"
    return label


def render_grouped(events: list[dict], cfg: dict, label: str, dim: str) -> str:
    """Build the grouped report: rows = distinct values of `dim`, columns = metric totals."""
    if not events:
        return f"(no events in window: {label})"

    # When grouping by cwd, build the alias resolution. Precedence:
    #   1. Explicit `project_names` entry → that name
    #   2. cwd is inside a git repo → basename(repo_root)
    #   3. Otherwise → MISC_LABEL ("misc")
    # Cwds not in any alias list don't pass through raw — the auto-alias path
    # always produces a friendly label.
    cwd_alias: dict[str, str] = {}
    if dim == "cwd":
        for name, paths in cfg.get("project_names", {}).items():
            for p in paths:
                cwd_alias[p] = name

    # Partition events by group key. Each group is rendered as one row.
    groups: dict[str, list[dict]] = {}
    for ev in events:
        key = _group_key(ev, dim)
        if dim == "cwd":
            if key in cwd_alias:
                key = cwd_alias[key]
            else:
                key = _auto_alias_for_cwd(key)
        groups.setdefault(key, []).append(ev)

    # Compute per-group metrics. tool_durations / session_active are already
    # per-event aggregators; gap_buckets returns a flat list we sum per-group.
    rows: list[tuple[str, int, int, int, int, int]] = []
    for key, sub_events in groups.items():
        tool_totals = reclassify.tool_durations_ms(sub_events)
        tool_total_ms = sum(tool_totals.values())
        active_per_session = reclassify.session_active_ms(sub_events)
        active_total_ms = sum(active_per_session.values())
        gaps = reclassify.gap_buckets(
            sub_events,
            chars_per_sec=cfg["chars_per_sec"],
            reading_threshold_sec=cfg["reading_threshold_sec"],
            thinking_threshold_sec=cfg["thinking_threshold_sec"],
        )
        reading_ms = sum(g.effective_ms for g in gaps if g.bucket == "reading")
        thinking_ms = sum(g.effective_ms for g in gaps if g.bucket == "thinking")
        away_ms = sum(g.effective_ms for g in gaps if g.bucket == "away")
        rows.append((key, tool_total_ms, active_total_ms, reading_ms, thinking_ms, away_ms))

    # Sort by engagement total (tool + active) desc, tie-break alphabetically.
    rows.sort(key=lambda r: (-(r[1] + r[2]), r[0]))

    # Truncate session labels for readability; cwd/day pass through full.
    label_width = 14 if dim == "session" else max((len(r[0]) for r in rows), default=8)
    label_width = max(label_width, len(dim))

    lines: list[str] = []
    lines.append(f"claude-time report — {label}")
    sessions = sorted({e["session_id"] for e in events if e.get("session_id")})
    lines.append(f"sessions: {len(sessions)}   events: {len(events)}")
    lines.append("")
    lines.append(f"── Grouped by {dim} ──")
    lines.append(
        f"  thresholds: reading ≤ {cfg['reading_threshold_sec']}s,  "
        f"thinking ≤ {cfg['thinking_threshold_sec']}s,  away > {cfg['thinking_threshold_sec']}s"
    )
    lines.append(f"  typing debit: {cfg['chars_per_sec']} chars/sec")
    lines.append("")

    header = (
        f"  {dim:<{label_width}}  "
        f"{'tool':>8}  {'active':>8}  {'reading':>8}  {'thinking':>9}  {'away':>6}  {'total':>8}"
    )
    lines.append(header)
    for key, tool_ms, active_ms, reading_ms, thinking_ms, away_ms in rows:
        shown = _short_label(key, dim, label_width)
        row_total = tool_ms + active_ms + reading_ms + thinking_ms + away_ms
        lines.append(
            f"  {shown:<{label_width}}  "
            f"{fmt_ms(tool_ms):>8}  {fmt_ms(active_ms):>8}  "
            f"{fmt_ms(reading_ms):>8}  {fmt_ms(thinking_ms):>9}  {fmt_ms(away_ms):>6}  {fmt_ms(row_total):>8}"
        )

    # Aggregate totals row. Grand total = sum of column totals (== sum of per-row totals).
    tot_tool = sum(r[1] for r in rows)
    tot_active = sum(r[2] for r in rows)
    tot_reading = sum(r[3] for r in rows)
    tot_thinking = sum(r[4] for r in rows)
    tot_away = sum(r[5] for r in rows)
    grand_total = tot_tool + tot_active + tot_reading + tot_thinking + tot_away
    lines.append("")
    lines.append(
        f"  {'TOTAL':<{label_width}}  "
        f"{fmt_ms(tot_tool):>8}  {fmt_ms(tot_active):>8}  "
        f"{fmt_ms(tot_reading):>8}  {fmt_ms(tot_thinking):>9}  {fmt_ms(tot_away):>6}  {fmt_ms(grand_total):>8}"
    )

    return "\n".join(lines)


def render_report(events: list[dict], cfg: dict, label: str) -> str:
    """Build the plain-text report from events + config."""
    if not events:
        return f"(no events in window: {label})"

    sessions = sorted({e["session_id"] for e in events if e.get("session_id")})
    gaps = reclassify.gap_buckets(
        events,
        chars_per_sec=cfg["chars_per_sec"],
        reading_threshold_sec=cfg["reading_threshold_sec"],
        thinking_threshold_sec=cfg["thinking_threshold_sec"],
    )
    tool_totals = reclassify.tool_durations_ms(events)
    agent_totals = reclassify.subagent_durations_ms(events)
    active_per_session = reclassify.session_active_ms(events)

    lines: list[str] = []
    lines.append(f"claude-time report — {label}")
    lines.append(f"sessions: {len(sessions)}   events: {len(events)}")
    lines.append("")

    # Tool time
    lines.append("── Tool time (Pre→Post wall-clock, summed) ──")
    if tool_totals:
        max_name = max(len(t) for t in tool_totals)
        for tool in sorted(tool_totals, key=lambda t: -tool_totals[t]):
            lines.append(f"  {tool:<{max_name}}  {fmt_ms(tool_totals[tool])}")
    else:
        lines.append("  (no tool calls in window)")
    lines.append("")

    # Subagent time
    lines.append("── Subagent time (Start→Stop wall-clock, summed) ──")
    if agent_totals:
        max_name = max(len(t) for t in agent_totals)
        for atype in sorted(agent_totals, key=lambda t: -agent_totals[t]):
            lines.append(f"  {atype:<{max_name}}  {fmt_ms(agent_totals[atype])}")
    else:
        lines.append("  (no subagent spawns in window)")
    lines.append("")

    # Active session time
    lines.append("── Active session time (UserPromptSubmit → Stop windows) ──")
    if active_per_session:
        total_active = sum(active_per_session.values())
        lines.append(f"  total across {len(active_per_session)} session(s):  {fmt_ms(total_active)}")
        if len(active_per_session) > 1:
            for sid in sorted(active_per_session, key=lambda s: -active_per_session[s]):
                short_sid = sid[:12] + ("…" if len(sid) > 12 else "")
                lines.append(f"    {short_sid}  {fmt_ms(active_per_session[sid])}")
    else:
        lines.append("  (no complete UserPromptSubmit→Stop windows)")
    lines.append("")

    # Reclassified gaps
    lines.append("── Reclassified gap buckets (per session) ──")
    if gaps:
        by_session: dict[str, dict[str, int]] = {}
        for g in gaps:
            row = by_session.setdefault(
                g.session_id, {"reading": 0, "thinking": 0, "away": 0}
            )
            row[g.bucket] += g.effective_ms
        lines.append(f"  thresholds: reading ≤ {cfg['reading_threshold_sec']}s,  "
                     f"thinking ≤ {cfg['thinking_threshold_sec']}s,  away > {cfg['thinking_threshold_sec']}s")
        lines.append(f"  typing debit: {cfg['chars_per_sec']} chars/sec")
        lines.append("")
        lines.append("  session         reading    thinking    away")
        for sid in sorted(by_session):
            row = by_session[sid]
            short_sid = sid[:12] + ("…" if len(sid) > 12 else "")
            lines.append(
                f"  {short_sid:<14}  {fmt_ms(row['reading']):>8}  {fmt_ms(row['thinking']):>9}  {fmt_ms(row['away']):>6}"
            )
        # Aggregate totals
        totals = {"reading": 0, "thinking": 0, "away": 0}
        for row in by_session.values():
            for k in totals:
                totals[k] += row[k]
        lines.append("")
        lines.append(
            f"  TOTAL           {fmt_ms(totals['reading']):>8}  "
            f"{fmt_ms(totals['thinking']):>9}  {fmt_ms(totals['away']):>6}"
        )
    else:
        lines.append("  (no Stop→UserPromptSubmit gaps in window)")

    return "\n".join(lines)


# ── CLI entry point ─────────────────────────────────────────────────────────
def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(
        prog="claude-time",
        description="Query the local claude-time SQLite database.",
    )
    sub = parser.add_subparsers(dest="cmd", required=True)

    report = sub.add_parser("report", help="render a usage report")
    report.add_argument("--weekly", action="store_true", help="last 7 days")
    report.add_argument("--date", help="single day, YYYY-MM-DD")
    report.add_argument("--session", help="filter by session_id")
    report.add_argument("--cwd", help="filter by working directory")
    report.add_argument(
        "--by",
        choices=GROUP_DIMS,
        help="group output by a dimension instead of the default per-metric breakdown",
    )
    report.add_argument(
        "--db",
        help="override DB path (default: $CLAUDE_TIME_DIR/events.sqlite or ~/.claude-time/events.sqlite)",
    )

    viz = sub.add_parser("visualize", help="emit a self-contained dashboard HTML")
    viz.add_argument("--date", help="single day, YYYY-MM-DD (default: today)")
    viz.add_argument("--week", action="store_true",
                     help="initial view is the week rollup (default: day)")
    viz.add_argument("--demo", action="store_true",
                     help="use the design's bundled mock data instead of real SQLite (no DB access; "
                          "forces context-days-prior/after to 0 since demo data is single-day)")
    viz.add_argument("--no-open", action="store_true",
                     help="don't auto-open the emitted HTML in the default browser")
    viz.add_argument("--out", help="output path (default: ~/.claude-time/visualize.html)")
    viz.add_argument("--context-days-prior", type=int, default=None, metavar="N",
                     help="days of trailing context to load for the Day view data window "
                          "(default: viz_context_days_prior from config, or 14)")
    viz.add_argument("--context-days-after", type=int, default=None, metavar="M",
                     help="days of leading context to load for the Day view data window "
                          "(default: viz_context_days_after from config, or 7)")
    viz.add_argument("--range", dest="range", default=None, metavar="START:END",
                     help="render a custom date range [YYYY-MM-DD:YYYY-MM-DD] as the "
                          "shipped Custom view; mutually exclusive with --demo; --week "
                          "is ignored when present; --date is ignored when present "
                          "(the range carries its own start/end); --context-days-* are "
                          "ignored (range mode owns its own window). Cap "
                          "viz_custom_range_max_days (default 90).")
    viz.add_argument("--month", dest="month", default=None, metavar="YYYY-MM",
                     help="render a calendar-month rollup as the Month view; "
                          "mutually exclusive with --range and --demo; --week and --date "
                          "are ignored when present (the month carries its own window). "
                          "Emit-time pre-loads the requested month plus the previous "
                          "month so the prev-arrow swap is instant client-side.")
    viz.add_argument("--compare", dest="compare", default=None,
                     choices=["wow", "today-vs-trailing", "mom"],
                     help="render the Compare view (delta lens) with a preset comparison: "
                          "wow=week-over-week, today-vs-trailing=today vs trailing 7-day, "
                          "mom=month-over-month. Mutually exclusive with --compare-range, "
                          "--range, --month, --date (when explicitly set); compatible with "
                          "--demo (synthetic window).")
    viz.add_argument("--compare-range", dest="compare_range", default=None,
                     metavar="A_START:A_END,B_START:B_END",
                     help="render the Compare view with two user-picked windows separated "
                          "by a comma. Each half follows the same YYYY-MM-DD:YYYY-MM-DD "
                          "shape as --range. Mutually exclusive with --compare, --range, "
                          "--month, --date (when explicitly set); cap "
                          "viz_custom_range_max_days applies per window.")
    viz.add_argument(
        "--db",
        help="override DB path (default: $CLAUDE_TIME_DIR/events.sqlite or ~/.claude-time/events.sqlite)",
    )

    args = parser.parse_args(argv)

    # Resolve DB + config dir (shared by both subcommands).
    if args.db:
        db_path = Path(args.db).expanduser()
        claude_time_dir = db_path.parent
    else:
        claude_time_dir = Path(os.environ.get("CLAUDE_TIME_DIR") or
                               Path.home() / ".claude-time")
        db_path = claude_time_dir / "events.sqlite"

    cfg = load_config(claude_time_dir)

    if args.cmd == "visualize":
        return _cmd_visualize(args, cfg, db_path, claude_time_dir)

    # `report` subcommand (default code path)
    start_ms, end_ms, label = window_ms(
        weekly=args.weekly, date_str=args.date
    )

    events = load_events(
        db_path,
        start_ms=start_ms,
        end_ms=end_ms,
        session_filter=args.session,
        cwd_filter=args.cwd,
    )

    if args.by:
        print(render_grouped(events, cfg, label, args.by))
    else:
        print(render_report(events, cfg, label))
    return 0


def _parse_month_flag(raw: str, today: date) -> tuple[date, date] | None:
    """Parse and validate `--month YYYY-MM`.

    On success returns (month_start, month_end) — first and last day of the
    month, inclusive. On failure prints a stderr message naming the rule that
    failed and returns None; caller exits with code 2.

    Validation rules:
      - shape: `^\\d{4}-\\d{2}$` (exactly 7 chars, 4-digit year, '-', 2-digit month)
      - month bounds: 1 <= month <= 12
      - not in future: (year, month) <= (today.year, today.month)
    """
    import re as _re
    import calendar as _calendar
    if not _re.match(r"^\d{4}-\d{2}$", raw):
        print(f"error: --month expects YYYY-MM shape (e.g. 2026-04), got {raw!r}",
              file=sys.stderr)
        return None
    try:
        year = int(raw[:4])
        month = int(raw[5:])
    except ValueError as e:
        print(f"error: --month parse failed: {e}", file=sys.stderr)
        return None
    if month < 1 or month > 12:
        print(f"error: --month requires month in 01..12; got month={month:02d}",
              file=sys.stderr)
        return None
    if (year, month) > (today.year, today.month):
        print(f"error: --month must not be in the future; got {year:04d}-{month:02d} "
              f"(today={today.isoformat()})", file=sys.stderr)
        return None
    last_day = _calendar.monthrange(year, month)[1]
    return date(year, month, 1), date(year, month, last_day)


def _prev_month(year: int, month: int) -> tuple[int, int]:
    """Return (year, month) of the calendar month preceding (year, month)."""
    if month == 1:
        return year - 1, 12
    return year, month - 1


def _parse_range_flag(raw: str, max_days: int) -> tuple[date, date] | None:
    """Parse and validate `--range START:END`.

    On success returns (start_date, end_date) inclusive.
    On any failure, prints a stderr message naming the rule that failed and
    returns None — caller exits with code 2.

    Validation rules (mirrored on the client side in Phase 2 via
    `window.CT_MAX_RANGE_DAYS`):
      - shape: exactly one ':' separator, two YYYY-MM-DD halves
      - end >= start (no inverted range)
      - end <= today (no future range — events haven't happened yet)
      - (end - start) + 1 <= max_days (cap from viz_custom_range_max_days)
    """
    parts = raw.split(":")
    if len(parts) != 2 or not parts[0] or not parts[1]:
        print(f"error: --range expects START:END in YYYY-MM-DD:YYYY-MM-DD form, got {raw!r}",
              file=sys.stderr)
        return None
    try:
        start = date.fromisoformat(parts[0])
        end = date.fromisoformat(parts[1])
    except ValueError as e:
        print(f"error: --range date parse failed: {e}", file=sys.stderr)
        return None
    if end < start:
        print(f"error: --range requires end >= start; got start={start.isoformat()} "
              f"end={end.isoformat()}", file=sys.stderr)
        return None
    if end > date.today():
        print(f"error: --range end must not be in the future; got end={end.isoformat()} "
              f"(today={date.today().isoformat()})", file=sys.stderr)
        return None
    days = (end - start).days + 1
    if days > max_days:
        print(f"error: --range exceeds viz_custom_range_max_days cap "
              f"({days} days > {max_days}); narrow the range or raise the cap in "
              f"~/.claude-time/config.json", file=sys.stderr)
        return None
    return start, end


def _compare_window_bounds(
    preset: str,
    compare_range_pair: tuple[tuple[date, date], tuple[date, date]] | None,
    target_day: date,
    monday: date,
) -> tuple[date, date, date, date]:
    """Return (a_start, a_end, b_start, b_end) for the given comparison preset.

    Window selection:
      wow                 → A=[monday-7..monday-1], B=[monday..monday+6]
      today-vs-trailing   → A=[target-7..target-1], B=[target, target]
      mom                 → A=prev calendar month, B=current calendar month
                            (anchored to target_day)
      custom              → caller-supplied (compare_range_pair must be set)
    """
    import calendar as _calendar
    if preset == "wow":
        a_start = monday - timedelta(days=7)
        a_end = monday - timedelta(days=1)
        b_start = monday
        b_end = monday + timedelta(days=6)
        return a_start, a_end, b_start, b_end
    if preset == "today-vs-trailing":
        a_start = target_day - timedelta(days=7)
        a_end = target_day - timedelta(days=1)
        b_start = target_day
        b_end = target_day
        return a_start, a_end, b_start, b_end
    if preset == "mom":
        year, month = target_day.year, target_day.month
        prev_y, prev_m = _prev_month(year, month)
        a_start = date(prev_y, prev_m, 1)
        a_end = date(prev_y, prev_m, _calendar.monthrange(prev_y, prev_m)[1])
        b_start = date(year, month, 1)
        b_end = date(year, month, _calendar.monthrange(year, month)[1])
        return a_start, a_end, b_start, b_end
    if preset == "custom":
        if compare_range_pair is None:
            raise ValueError("preset='custom' requires compare_range_pair to be set")
        (a_start, a_end), (b_start, b_end) = compare_range_pair
        return a_start, a_end, b_start, b_end
    raise ValueError(f"unknown compare preset: {preset!r}")


def _build_demo_comparison(
    preset: str,
    compare_range_pair: tuple[tuple[date, date], tuple[date, date]] | None,
    cfg: dict,
) -> dict:
    """Build an empty-shape comparison payload for the --demo path.

    Demo data is a single-day fixture (viz/data.js); we cannot compute real
    comparison numbers. Emit an empty-shape tree that keeps the JS contract
    uniform — both A and B are empty range payloads, deltas is empty, meta is
    populated so the UI can render window labels.
    """
    import viz_data  # noqa
    today = date.today()
    monday = today - timedelta(days=today.weekday())
    a_start, a_end, b_start, b_end = _compare_window_bounds(
        preset, compare_range_pair, today, monday,
    )

    def _auto_alias_noop(cwd: str) -> str:
        return cwd or "unknown"

    payload = viz_data.build_comparison_data(
        a_start.isoformat(), a_end.isoformat(),
        b_start.isoformat(), b_end.isoformat(),
        events_by_day_a={}, events_by_day_b={},
        cfg=cfg, auto_alias_fn=_auto_alias_noop,
    )

    # WP11 Phase 1.B: attach empty-shape metrics per window so the JS
    # contract is uniform (CompareView always reads comparison.a.metrics
    # and .b.metrics). Demo path has no real events to aggregate, so
    # build_metrics([], ...) produces the same shape as a real-data call
    # over an empty window — engaged_session.wallclock_ms === 0, etc.
    a_start_dt = datetime.combine(a_start, time.min)
    a_end_dt = datetime.combine(a_end + timedelta(days=1), time.min)
    b_start_dt = datetime.combine(b_start, time.min)
    b_end_dt = datetime.combine(b_end + timedelta(days=1), time.min)
    payload["a"]["metrics"] = viz_data.build_metrics([], a_start_dt, a_end_dt)
    payload["b"]["metrics"] = viz_data.build_metrics([], b_start_dt, b_end_dt)
    return payload


def _parse_compare_range_flag(
    raw: str, max_days: int
) -> tuple[tuple[date, date], tuple[date, date]] | None:
    """Parse and validate `--compare-range A_START:A_END,B_START:B_END`.

    On success returns ((a_start, a_end), (b_start, b_end)) inclusive.
    On any failure, prints a stderr message naming the rule that failed and
    returns None — caller exits with code 2.

    Validation rules:
      - shape: exactly one ',' separator, two A:B halves
      - each half satisfies `_parse_range_flag` (shape, end>=start, end<=today,
        days<=max_days). Windows of different lengths are allowed — the data
        layer is policy-free; the UI surfaces a warning at render time.
    """
    parts = raw.split(",")
    if len(parts) != 2 or not parts[0] or not parts[1]:
        print(f"error: --compare-range expects A_START:A_END,B_START:B_END "
              f"(two ranges separated by a comma), got {raw!r}", file=sys.stderr)
        return None
    a = _parse_range_flag(parts[0], max_days)
    if a is None:
        # _parse_range_flag already wrote a rule-named error; tag which half failed.
        print(f"error: --compare-range first range (A) failed validation", file=sys.stderr)
        return None
    b = _parse_range_flag(parts[1], max_days)
    if b is None:
        print(f"error: --compare-range second range (B) failed validation", file=sys.stderr)
        return None
    return a, b


def _cmd_visualize(args, cfg, db_path, claude_time_dir):
    """Emit the dashboard HTML to disk. See `--help visualize`."""
    import webbrowser
    import viz_data  # noqa — siblings via sys.path insert at top of file
    import viz_render  # noqa

    # Resolve viz/ assets relative to *resolved* script path (handles symlinks).
    viz_dir = Path(__file__).resolve().parent / "viz"
    template_path = viz_dir / "template.html"
    dashboard_jsx_path = viz_dir / "dashboard.jsx"
    if not template_path.exists() or not dashboard_jsx_path.exists():
        print(f"error: viz template assets not found under {viz_dir}", file=sys.stderr)
        return 2

    # WP11: cross-flag mutex check fires FIRST so the error message names the
    # right pair of flags. Without this, --compare + --range would hit the
    # --range vs --demo guard with a misleading message. Compare-range
    # parsing itself happens later (needs cfg for max_days).
    if args.compare is not None and args.compare_range is not None:
        print("error: --compare and --compare-range are mutually exclusive "
              "(pick one preset or one window-pair, not both)", file=sys.stderr)
        return 2
    if args.compare is not None or args.compare_range is not None:
        if args.range is not None:
            print("error: --compare/--compare-range is incompatible with --range "
                  "(pick one initial-view and window source)", file=sys.stderr)
            return 2
        if args.month is not None:
            print("error: --compare/--compare-range is incompatible with --month "
                  "(pick one initial-view and window source)", file=sys.stderr)
            return 2
        if args.date is not None:
            print("error: --compare/--compare-range is incompatible with --date "
                  "(pick one initial-view and window source)", file=sys.stderr)
            return 2

    # WP8: parse + validate --range early so error paths abort before any DB
    # work. Mutual-exclusion guards: --range conflicts with --demo (demo data
    # is single-day); --range silently overrides --date and --context-days-*
    # (range owns its own window).
    range_dates: tuple[date, date] | None = None
    if args.range is not None:
        if args.demo:
            print("error: --range is incompatible with --demo (demo data is single-day)",
                  file=sys.stderr)
            return 2
        max_days = int(cfg.get("viz_custom_range_max_days", 90))
        parsed = _parse_range_flag(args.range, max_days)
        if parsed is None:
            return 2
        range_dates = parsed
        if args.context_days_prior is not None or args.context_days_after is not None:
            print("warning: --context-days-prior/--context-days-after are ignored in "
                  "range mode (the range carries its own window).", file=sys.stderr)

    # WP7: parse + validate --month after --range so we can guard against
    # combined use. Mutual exclusion: --month conflicts with --range (both
    # specify the initial-view window) and with --demo (demo data is
    # single-day). --month silently overrides --date, --week, and
    # --context-days-* (the month carries its own window).
    month_dates: tuple[date, date] | None = None
    if args.month is not None:
        if args.demo:
            print("error: --month is incompatible with --demo (demo data is single-day)",
                  file=sys.stderr)
            return 2
        if args.range is not None:
            print("error: --month is incompatible with --range (pick one initial-view "
                  "and window source)", file=sys.stderr)
            return 2
        parsed = _parse_month_flag(args.month, date.today())
        if parsed is None:
            return 2
        month_dates = parsed

    # WP11: parse --compare-range now that --range / --month parsing is done.
    # Cross-flag mutex was checked above (before any parse) so the error
    # messages name the right pair of flags. --compare is a choice flag
    # (no parsing needed — argparse already validated against choices=).
    compare_preset: str | None = None
    compare_range_pair: tuple[tuple[date, date], tuple[date, date]] | None = None
    if args.compare_range is not None:
        max_days = int(cfg.get("viz_custom_range_max_days", 90))
        parsed_pair = _parse_compare_range_flag(args.compare_range, max_days)
        if parsed_pair is None:
            return 2
        compare_range_pair = parsed_pair
        compare_preset = "custom"
    elif args.compare is not None:
        compare_preset = args.compare

    # Pick today (or --date) for the day-view data.
    target_day = date.fromisoformat(args.date) if args.date else date.today()
    # ISO week's Monday for the week-view data.
    monday = target_day - timedelta(days=target_day.weekday())

    # WP5b: resolve effective multi-day-window sizing for Day view.
    # Precedence: CLI flag > config > built-in default. --demo forces both to 0
    # since the demo fixture (viz/data.js) is single-day.
    if args.demo:
        ctx_prior = 0
        ctx_after = 0
    else:
        ctx_prior = (args.context_days_prior
                     if args.context_days_prior is not None
                     else cfg["viz_context_days_prior"])
        ctx_after = (args.context_days_after
                     if args.context_days_after is not None
                     else cfg["viz_context_days_after"])
        # Defensive — CLI may pass negative; clamp to 0.
        ctx_prior = max(0, int(ctx_prior))
        ctx_after = max(0, int(ctx_after))

    # Snapshot timestamp — the wall-clock at emit time. Surfaced in the dashboard
    # as a "snapshot: HH:MM" caption next to the live NOW marker, so users can tell
    # the data is point-in-time even though the NOW cursor moves.
    snapshot_dt = datetime.now()
    meta = {
        "snapshot": snapshot_dt.strftime("%H:%M"),
        "snapshot_iso": snapshot_dt.isoformat(timespec="seconds"),
    }

    # WP10: trailing-7-day metrics window — always today's date + the prior
    # 6 days (today inclusive = 7 days). View-mode independent: the same
    # window is computed regardless of --demo / --week / --month / --range /
    # --date so Day/Week/Month/Custom all show the same metrics surface.
    # `snapshot_dt` already captures emit-time wall-clock above.
    metrics_window_end_dt = snapshot_dt
    metrics_window_start_dt = snapshot_dt - timedelta(days=6)

    if args.demo:
        # Use the design's bundled mock data without touching SQLite.
        data = _load_demo_data(viz_dir)
        data["meta"] = meta
        # WP10: emit an empty-shaped metrics tree on the demo path. The demo's
        # bundled events are not loaded as event-dicts here (the demo path
        # short-circuits SQLite), so we cannot run build_metrics over real
        # event rows. Emitting an empty-shape tree keeps the JS contract
        # uniform (always present) without inventing fake numbers.
        data["metrics"] = viz_data.build_metrics(
            [], metrics_window_start_dt, metrics_window_end_dt,
        )
        # WP11: emit an empty-shape comparison tree on the demo path. Like
        # `metrics`, the JS contract is always-present; demo has no real events
        # to compare so both windows are empty and deltas are zero/None. The
        # comparison window pair is derived from the preset choice so the UI
        # still has meta.{a_start, a_end, b_start, b_end} to render labels.
        if compare_preset is not None:
            data["comparison"] = _build_demo_comparison(
                compare_preset, compare_range_pair, cfg,
            )
    else:
        if not db_path.exists():
            print(f"error: {db_path} does not exist. Run Claude Code with CLAUDE_TIME_TRACKING=1 to populate it, "
                  f"or use --demo to render with mock data.", file=sys.stderr)
            return 2

        # WP8: when --range is active, override the Day-view window with the
        # user-picked range. build_range_data is the same data path WP5b uses
        # for multi-day Day view, so the emitted payload's `meta.start` +
        # `meta.end` + `meta.day_count` already cover what Phase 2's renderer
        # needs to seed the date-range picker.
        # WP7: --month does the same trick — its active-month window becomes
        # the Day-view-equivalent payload (so Day/Week tabs remain functional
        # on a Month-emit page per D6 fallback). The previous month is loaded
        # separately below for the months[] map.
        if month_dates is not None:
            day_window_start, day_window_end = month_dates
        elif range_dates is not None:
            day_window_start, day_window_end = range_dates
        else:
            # Day-view data window: target_day ± (ctx_prior, ctx_after). When
            # both are 0, this collapses to a single-day window —
            # build_range_data emits back-compat single-day shape (iso +
            # hour_range) for that case.
            day_window_start = target_day - timedelta(days=ctx_prior)
            day_window_end = target_day + timedelta(days=ctx_after)

        day_events_by_day = {}
        for i in range((day_window_end - day_window_start).days + 1):
            d = day_window_start + timedelta(days=i)
            day_events_by_day[d.isoformat()] = _load_window_events(db_path, d)
        if range_dates is None and month_dates is None and ctx_prior == 0 and ctx_after == 0:
            # Pure single-day Day view: keep build_day_data for byte-identical
            # legacy output. The --range and --month paths always use
            # build_range_data because their identity is defined by the
            # user-picked window, not the single-day shape.
            today_payload = viz_data.build_day_data(
                target_day.isoformat(),
                day_events_by_day[target_day.isoformat()],
                cfg,
                _auto_alias_for_cwd,
            )
        else:
            today_payload = viz_data.build_range_data(
                day_window_start.isoformat(),
                day_window_end.isoformat(),
                events_by_day=day_events_by_day,
                cfg=cfg,
                auto_alias_fn=_auto_alias_for_cwd,
            )
            if range_dates is None and month_dates is None:
                # WP5b: surface the user-requested day so the renderer can
                # center the initial viewport on it (otherwise it would center
                # on the window mid-point). Phase 2 (renderer) consumes this
                # field. NOT set in --range or --month mode — Custom and Month
                # views center on their own window; meta.start/.end suffice.
                today_payload["target_iso"] = target_day.isoformat()

        # Week payload is independent of Day's context-days window AND of
        # --range. Custom-view users can still click the Week tab and get a
        # sensible week-of-today rollup (WP8 explicitly scopes Week as
        # independent — see WIP plan's "Open questions").
        week_events_by_day = {}
        for i in range(7):
            d = monday + timedelta(days=i)
            week_events_by_day[d.isoformat()] = _load_window_events(db_path, d)
        week_payload = viz_data.build_week_data(monday.isoformat(),
                                                week_events_by_day, cfg, _auto_alias_for_cwd)
        data = {"today": today_payload, "week": week_payload, "meta": meta}

        # WP7: --month emits an additional `months` map containing the
        # active month + the previous month, keyed by ISO month string
        # (YYYY-MM). The active-month payload is byte-identical to
        # today_payload above (both are build_range_data over the same
        # window). The previous-month payload is loaded separately here so
        # the dashboard's prev-arrow can do a pure client-side state swap
        # without a CLI round-trip (D1).
        if month_dates is not None:
            active_iso = f"{month_dates[0].year:04d}-{month_dates[0].month:02d}"
            prev_y, prev_m = _prev_month(month_dates[0].year, month_dates[0].month)
            import calendar as _calendar
            prev_start = date(prev_y, prev_m, 1)
            prev_end = date(prev_y, prev_m, _calendar.monthrange(prev_y, prev_m)[1])
            prev_iso = f"{prev_y:04d}-{prev_m:02d}"
            prev_events_by_day = {}
            for i in range((prev_end - prev_start).days + 1):
                d = prev_start + timedelta(days=i)
                prev_events_by_day[d.isoformat()] = _load_window_events(db_path, d)
            prev_payload = viz_data.build_range_data(
                prev_start.isoformat(),
                prev_end.isoformat(),
                events_by_day=prev_events_by_day,
                cfg=cfg,
                auto_alias_fn=_auto_alias_for_cwd,
            )
            data["months"] = {active_iso: today_payload, prev_iso: prev_payload}

        # WP10: load trailing-7-day events (today + prior 6) and run the
        # metrics aggregator. Window is view-mode-independent — same metrics
        # surface regardless of Day/Week/Month/Custom. Events are loaded
        # per-day then concatenated and chronologically sorted.
        metrics_events: list[dict] = []
        metrics_window_start_date = metrics_window_start_dt.date()
        metrics_window_end_date = metrics_window_end_dt.date()
        for i in range((metrics_window_end_date - metrics_window_start_date).days + 1):
            d = metrics_window_start_date + timedelta(days=i)
            metrics_events.extend(_load_window_events(db_path, d))
        metrics_events.sort(key=lambda r: r.get("ts", 0))
        data["metrics"] = viz_data.build_metrics(
            metrics_events, metrics_window_start_dt, metrics_window_end_dt,
        )

        # WP11: when --compare or --compare-range is active, compute the
        # comparison payload. Window selection per preset:
        #   wow                 → compare_week_over_week(monday_iso)
        #   today-vs-trailing   → compare_day_vs_trailing_window(target_iso, 7)
        #   mom                 → compare_month_over_month(this_month_iso)
        #   custom              → build_comparison_data(A_start..A_end, B_start..B_end)
        # Events are loaded for the union of A and B windows.
        if compare_preset is not None:
            (cmp_a_start, cmp_a_end,
             cmp_b_start, cmp_b_end) = _compare_window_bounds(
                compare_preset, compare_range_pair, target_day, monday,
            )
            union_start = min(cmp_a_start, cmp_b_start)
            union_end = max(cmp_a_end, cmp_b_end)
            cmp_events_by_day: dict[str, list[dict]] = {}
            for i in range((union_end - union_start).days + 1):
                d = union_start + timedelta(days=i)
                cmp_events_by_day[d.isoformat()] = _load_window_events(db_path, d)
            data["comparison"] = viz_data.build_comparison_data(
                cmp_a_start.isoformat(), cmp_a_end.isoformat(),
                cmp_b_start.isoformat(), cmp_b_end.isoformat(),
                events_by_day_a={
                    iso: evts for iso, evts in cmp_events_by_day.items()
                    if cmp_a_start <= date.fromisoformat(iso) <= cmp_a_end
                },
                events_by_day_b={
                    iso: evts for iso, evts in cmp_events_by_day.items()
                    if cmp_b_start <= date.fromisoformat(iso) <= cmp_b_end
                },
                cfg=cfg,
                auto_alias_fn=_auto_alias_for_cwd,
            )

            # WP11 Phase 1.B: per-window metrics emit. Compute build_metrics
            # over each window's events so the CompareView UI can render
            # productivity ratios (parallelism multiplier, AI-effort/human-
            # wall-clock, blocking split, concurrency mix). Events for both
            # windows are already loaded in cmp_events_by_day — extract per
            # window, sort chronologically, call build_metrics, attach.
            # Window endpoint convention matches _load_window_events: start
            # at midnight-local of the first day, end at midnight-local of
            # the day AFTER the last day (exclusive upper bound).
            def _metrics_for_window(win_start: date, win_end: date) -> dict:
                evts: list[dict] = []
                for iso, day_evts in cmp_events_by_day.items():
                    d = date.fromisoformat(iso)
                    if win_start <= d <= win_end:
                        evts.extend(day_evts)
                evts.sort(key=lambda r: r.get("ts", 0))
                start_dt = datetime.combine(win_start, time.min)
                end_dt = datetime.combine(win_end + timedelta(days=1), time.min)
                return viz_data.build_metrics(evts, start_dt, end_dt)

            data["comparison"]["a"]["metrics"] = _metrics_for_window(cmp_a_start, cmp_a_end)
            data["comparison"]["b"]["metrics"] = _metrics_for_window(cmp_b_start, cmp_b_end)

    # WP7/WP8/WP11: initial view precedence — --compare* > --month > --range >
    # --week > default. --compare and --compare-range are mutually exclusive
    # with --month and --range (mutex guarded above), so reaching the
    # "compare" branch implies the others are unset.
    if compare_preset is not None:
        initial_view = "compare"
    elif month_dates is not None:
        initial_view = "month"
    elif range_dates is not None:
        initial_view = "custom"
    elif args.week:
        initial_view = "week"
    else:
        initial_view = "day"
    max_range_days = int(cfg.get("viz_custom_range_max_days", 90))
    html = viz_render.render_html(template_path, dashboard_jsx_path, data,
                                  initial_view, max_range_days=max_range_days,
                                  initial_preset=compare_preset)

    out_path = Path(args.out).expanduser() if args.out else (claude_time_dir / "visualize.html")
    out_path.parent.mkdir(parents=True, exist_ok=True)
    out_path.write_text(html)
    print(out_path)

    if not args.no_open:
        webbrowser.open(f"file://{out_path}")
    return 0


def _load_window_events(db_path: Path, day) -> list[dict]:
    """Load a single day's events from the DB. Returns [] if DB missing."""
    if not db_path.exists():
        return []
    start_dt = datetime.combine(day, time.min)
    end_dt = datetime.combine(day + timedelta(days=1), time.min)
    start_ms = int(start_dt.timestamp() * 1000)
    end_ms = int(end_dt.timestamp() * 1000)
    conn = sqlite3.connect(f"file:{db_path}?mode=ro", uri=True)
    conn.row_factory = sqlite3.Row
    try:
        rows = [dict(r) for r in conn.execute(
            "SELECT * FROM events WHERE ts >= ? AND ts < ? ORDER BY ts",
            (start_ms, end_ms),
        )]
    finally:
        conn.close()
    return rows


def _load_demo_data(viz_dir: Path) -> dict:
    """Parse the design's bundled `data.js` IIFE into the dict the renderer
    expects. Avoids running JS — we extract the literal via a small regex
    over the well-known structure of the design's data.js.

    The design's `data.js` is byte-pinned by Phase 5c structural checks, so
    its shape is stable. If a future revision changes it, this loader will
    fail loudly and Phase 5c will catch the drift.
    """
    text = (viz_dir / "data.js").read_text()
    # The file is a self-contained IIFE that builds two objects: `today` and
    # `week`. We extract them by running the file's body in a Python eval
    # equivalent — but JS object literals aren't valid Python. Simplest fix:
    # shell out to node to evaluate the file, then JSON-stringify the result.
    # node is documented as a build-time dep (Phase 5c uses node --check).
    import subprocess
